# Copy this file to .env for local development.
# All values below are development-only placeholders — never real credentials.

# --- Database (local Docker Postgres, see docker-compose.yml) ---
DATABASE_URL="postgresql://flicks_dev:flicks_dev_password@localhost:5434/flicks_licks_dev?schema=public"

# --- Redis (local Docker Redis, see docker-compose.yml) ---
REDIS_URL="redis://localhost:6382"

# --- Auth.js ---
# Generate a real secret with: npx auth secret
AUTH_SECRET="dev-only-insecure-secret-change-me"
AUTH_TRUST_HOST="true"
# NEXTAUTH_URL: leave unset in dev (AUTH_TRUST_HOST infers the origin from the
# request). Set explicitly in production, e.g. NEXTAUTH_URL="https://app.flicksandlicks.com"

# --- App ---
NODE_ENV="development"
DEFAULT_CURRENCY="GHS"
DEFAULT_TIMEZONE="Africa/Accra"

# --- Delivery maps & routing (see src/modules/delivery/providers/README.md) ---
# Client-safe (shipped to the browser): the MapLibre style URL. Defaults to
# OpenFreeMap's free "liberty" style (no API key) if unset. Point this at a
# self-hosted tileserver (openfreemap.org is self-hostable) or a commercial
# vector-tile provider for production — the public OpenFreeMap instance has
# no SLA. NOTE: if you change this to a host that serves tiles from more
# than one origin, also update src/proxy.ts's CSP (it derives connect-src
# from this URL's origin automatically for the single-origin case).
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Server-only: the OSRM-compatible routing API base URL. Defaults to the
# public OSRM demo server, which explicitly asks not to be used for
# production/commercial traffic (rate-limited, no SLA) — self-host OSRM (see
# https://github.com/Project-OSRM/osrm-backend) or point this at a paid
# routing provider with an OSRM-compatible API for production.
ROUTING_API_URL="https://router.project-osrm.org"
