# Copy this file to .env for local development.
# All values below are development-only placeholders — never real credentials.

# --- Database (local Docker Postgres, see docker-compose.yml) ---
DATABASE_URL="postgresql://flicks_dev:flicks_dev_password@localhost:5434/flicks_licks_dev?schema=public"

# --- Redis (local Docker Redis, see docker-compose.yml) ---
REDIS_URL="redis://localhost:6382"

# --- Auth.js ---
# Generate a real secret with: npx auth secret
AUTH_SECRET="dev-only-insecure-secret-change-me"
AUTH_TRUST_HOST="true"
# NEXTAUTH_URL: leave unset in dev (AUTH_TRUST_HOST infers the origin from the
# request). Set explicitly in production, e.g. NEXTAUTH_URL="https://app.flicksandlicks.com"

# The one URL staff use to reach the sign-in page — see proxy.ts. Everything
# under /admin, /pos, /kitchen, /rider, /account, /login 404s for anyone who
# doesn't arrive via /<this value> first, so the backend isn't discoverable
# by guessing common paths. Generate a real one with:
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
STAFF_ACCESS_KEY="dev-only-insecure-staff-gate-change-me"

# --- App ---
NODE_ENV="development"
DEFAULT_CURRENCY="GHS"
DEFAULT_TIMEZONE="Africa/Accra"

# --- Delivery maps & routing (see src/modules/delivery/providers/README.md) ---
# Client-safe (shipped to the browser): the MapLibre style URL. Defaults to
# OpenFreeMap's free "liberty" style (no API key) if unset. Point this at a
# self-hosted tileserver (openfreemap.org is self-hostable) or a commercial
# vector-tile provider for production — the public OpenFreeMap instance has
# no SLA. NOTE: if you change this to a host that serves tiles from more
# than one origin, also update src/proxy.ts's CSP (it derives connect-src
# from this URL's origin automatically for the single-origin case).
NEXT_PUBLIC_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# Server-only: the OSRM-compatible routing API base URL. Defaults to the
# public OSRM demo server, which explicitly asks not to be used for
# production/commercial traffic (rate-limited, no SLA) — self-host OSRM (see
# https://github.com/Project-OSRM/osrm-backend) or point this at a paid
# routing provider with an OSRM-compatible API for production.
ROUTING_API_URL="https://router.project-osrm.org"

# --- Real integrations (all optional — every one below falls back to a dev
# stand-in until set, so the app works unchanged without any of them) ---

# Absolute origin used to build the Paystack payment redirect's callback URL.
# Not needed on Vercel (VERCEL_URL covers it); set explicitly elsewhere, e.g.
# APP_URL="https://app.flicksandlicks.com"
# APP_URL=""

# Real Ghana Mobile Money (MTN MoMo / Vodafone Cash / AirtelTigo) via
# Paystack's hosted checkout. Falls back to MobileMoneyDevProvider (the
# in-app "simulate payment" button) until this is set. Also configure the
# webhook in the Paystack dashboard: <APP_URL>/api/webhooks/paystack
# PAYSTACK_SECRET_KEY=""

# The dev "simulate payment success" stand-in is refused in production
# unless this is set to "true" — it exists purely to test the order flow
# before a real gateway is wired up. WARNING: while on, anyone who completes
# storefront checkout can mark their own order paid for free (no money is
# ever collected). Set back to "false" (or unset) once real customers can
# reach the site.
# ALLOW_DEV_PAYMENT_SIMULATION="false"

# A fixed 6-digit code accepted for ANY phone number's OTP verification, on
# top of the real per-phone code — lets you test the order flow without
# waiting on real SMS or reading the dev-code banner each time. WARNING:
# anyone who knows this code can verify any phone number while it's set.
# Unset (or rotate) it once real customers can reach the site.
# OTP_TEST_BYPASS_CODE=""

# Real SMS delivery (Twilio). All three must be set together or none are used.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# Real email delivery (Resend). Both must be set together.
# RESEND_API_KEY=""
# EMAIL_FROM_ADDRESS="orders@flicksandlicks.com"
