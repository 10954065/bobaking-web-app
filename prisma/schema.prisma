// Boba King Restaurant OS — Phase 1: Foundation
// Identity, RBAC, multi-branch structure, audit logging.
// Later phases extend this file with orders, inventory, delivery, marketing, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Geography / Branch structure
// ---------------------------------------------------------------------------

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  isoCode   String   @unique
  currency  String   @default("GHS")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  regions Region[]

  @@map("countries")
}

model Region {
  id        String   @id @default(uuid())
  name      String
  countryId String   @map("country_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities  City[]

  @@unique([countryId, name])
  @@map("regions")
}

model City {
  id        String   @id @default(uuid())
  name      String
  regionId  String   @map("region_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  region   Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  branches Branch[]

  @@unique([regionId, name])
  @@map("cities")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
  TEMPORARILY_CLOSED
}

model Branch {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  cityId    String       @map("city_id")
  address   String
  latitude  Decimal?     @db.Decimal(10, 7)
  longitude Decimal?     @db.Decimal(10, 7)
  phone     String?
  email     String?
  status    BranchStatus @default(ACTIVE)
  timezone  String       @default("Africa/Accra")
  currency  String       @default("GHS")

  /// Configurable, not hard-coded — see CRITICAL rule against hard-coded tax rates. Defaults to 0 until finance configures it.
  taxRate Decimal @default(0) @map("tax_rate") @db.Decimal(5, 4)

  /// Fallback delivery fee used when an order's delivery address doesn't match any DeliveryZone for this branch AND there are no coordinates to price a distance-based fare from — configurable per branch, never hard-coded. Also acts as the minimum fare floor for the distance-based calculation below.
  defaultDeliveryFee Decimal @default(0) @map("default_delivery_fee") @db.Decimal(10, 2)

  /// Distance-based delivery fare model (same linear shape as Bolt/Yango/Uber: base + per-km + per-minute), used whenever both the branch and the delivery address have coordinates and no explicit DeliveryZone matches. See fare.service.ts.
  deliveryBaseFare      Decimal @default(5) @map("delivery_base_fare") @db.Decimal(10, 2)
  deliveryPerKmRate     Decimal @default(2) @map("delivery_per_km_rate") @db.Decimal(10, 2)
  deliveryPerMinuteRate Decimal @default(0.3) @map("delivery_per_minute_rate") @db.Decimal(10, 2)

  // JSON schedule: { mon: {open, close}, tue: {...}, ... }. Configurable per branch, not hard-coded.
  openingHours Json? @map("opening_hours")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  city             City                    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  userRoles        UserRole[]
  auditLogs        AuditLog[]
  productOverrides ProductBranchOverride[]
  carts            Cart[]
  orders           Order[]
  kitchenStations  KitchenStation[]
  ingredientStocks BranchIngredientStock[]
  stockMovements   StockMovement[]
  purchaseOrders   PurchaseOrder[]
  deliveryZones    DeliveryZone[]
  riderProfiles    RiderProfile[]
  promotions       Promotion[]
  supportTickets   SupportTicket[]
  reviews          Review[]

  @@index([cityId])
  @@index([status])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  phone         String?   @unique
  phoneVerified DateTime? @map("phone_verified")
  passwordHash  String?   @map("password_hash")

  // Auth.js convenience fields (kept alongside the structured name/avatar fields below).
  name  String?
  image String?

  firstName String @map("first_name")
  lastName  String @map("last_name")

  status UserStatus @default(ACTIVE)

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  lastLoginIp         String?   @map("last_login_ip")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  accounts  Account[]
  sessions  Session[]
  userRoles UserRole[]
  auditLogs AuditLog[] @relation("AuditActor")

  placedOrders        Order[]              @relation("OrderPlacedBy")
  orderStatusChanges  OrderStatusHistory[]
  paymentsInitiated   Payment[]
  refundsInitiated    Refund[]
  stockMovements      StockMovement[]
  purchaseOrders      PurchaseOrder[]
  riderProfile        RiderProfile?
  assignedDeliveries  Order[]              @relation("OrderAssignedRider")
  deliveryLocations   DeliveryLocation[]
  loyaltyAdjustments  LoyaltyTransaction[]
  assignedTickets     SupportTicket[]      @relation("SupportTicketAssignee")
  supportMessages     SupportMessage[]
  moderatedReviews    Review[]             @relation("ReviewModerator")
  passwordResetTokens PasswordResetToken[]

  @@index([status])
  @@index([email])
  @@index([phone])
  @@map("users")
}

/// Self-service "forgot password" flow. Only the SHA-256 hash of the token is
/// stored (never the raw token) — same reasoning as a password hash: a DB
/// leak must not hand out working reset links. Single-use (usedAt) and
/// short-lived (expiresAt); see password-reset.service.ts.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Reserved for future OAuth / SSO providers. Credentials auth does not use this table today.
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  // Device/session tracking (security requirement: visibility into active sessions).
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// RBAC — roles and permissions are data, not hard-coded enums, so new roles
// or permissions can be introduced without a migration touching application code.
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// A user can hold multiple roles. branchId = null means the role applies
// globally across all branches (e.g. SUPER_ADMIN); a set branchId scopes
// that role assignment to a single branch (e.g. ADMIN for East Legon only).
model UserRole {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  roleId   String  @map("role_id")
  branchId String? @map("branch_id")

  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Audit — append-only from the application's perspective. No update/delete
// helpers are exposed anywhere in the service layer.
// ---------------------------------------------------------------------------

model AuditLog {
  id           String  @id @default(uuid())
  actorUserId  String? @map("actor_user_id")
  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id")
  branchId     String? @map("branch_id")

  before   Json?
  after    Json?
  metadata Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@index([branchId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog — products/categories/modifiers are global by default. A branch can
// override price and/or availability per product without duplicating it (see
// ProductBranchOverride) — this is what lets one branch sell an item another
// doesn't, or price it differently, without forking the catalog.
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String? @map("image_url")
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("categories")
}

model Product {
  id          String  @id @default(uuid())
  categoryId  String  @map("category_id")
  name        String
  slug        String  @unique
  description String?
  basePrice   Decimal @map("base_price") @db.Decimal(10, 2)
  imageUrl    String? @map("image_url")
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  /// Logical station tag (e.g. "fries", "grill"), not a hard FK — Product is
  /// global but KitchenStation rows are per-branch, so this gets resolved
  /// against whichever branch's stations share the slug at order time.
  stationSlug String? @map("station_slug")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branchOverrides ProductBranchOverride[]
  modifierGroups  ProductModifierGroup[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  recipeItems     RecipeItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

/// price = null means "use the product's basePrice at this branch" — only set
/// a value here when this branch genuinely charges a different price.
model ProductBranchOverride {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  branchId    String   @map("branch_id")
  price       Decimal? @db.Decimal(10, 2)
  isAvailable Boolean  @default(true) @map("is_available")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@map("product_branch_overrides")
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

model ModifierGroup {
  id            String                @id @default(uuid())
  name          String
  selectionType ModifierSelectionType @default(SINGLE) @map("selection_type")
  isRequired    Boolean               @default(false) @map("is_required")
  minSelect     Int                   @default(0) @map("min_select")
  maxSelect     Int?                  @map("max_select")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  options  ModifierOption[]
  products ProductModifierGroup[]

  @@map("modifier_groups")
}

model ModifierOption {
  id              String  @id @default(uuid())
  modifierGroupId String  @map("modifier_group_id")
  name            String
  priceDelta      Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  modifierGroup  ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  cartItemLinks  CartItemModifier[]
  orderItemLinks OrderItemModifier[]

  @@index([modifierGroupId])
  @@map("modifier_options")
}

model ProductModifierGroup {
  productId       String @map("product_id")
  modifierGroupId String @map("modifier_group_id")
  sortOrder       Int    @default(0) @map("sort_order")

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

// ---------------------------------------------------------------------------
// Customers — deliberately separate from User: customers are never granted
// RBAC roles, and passwordHash is optional so guest customers created by
// staff (POS walk-ins) don't need an account at all.
// ---------------------------------------------------------------------------

enum CustomerStatus {
  ACTIVE
  GUEST
  SUSPENDED
}

model Customer {
  id            String         @id @default(uuid())
  email         String?        @unique
  emailVerified DateTime?      @map("email_verified")
  phone         String?        @unique
  phoneVerified DateTime?      @map("phone_verified")
  passwordHash  String?        @map("password_hash")
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  status        CustomerStatus @default(GUEST)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  addresses           CustomerAddress[]
  carts               Cart[]
  orders              Order[]
  loyaltyAccount      LoyaltyAccount?
  loyaltyTransactions LoyaltyTransaction[]
  supportTickets      SupportTicket[]
  reviews             Review[]
  notifications       Notification[]
  sessions            CustomerSession[]

  @@index([status])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

/// A one-time code sent by SMS to prove ownership of a phone number before
/// it becomes a Customer's login identity — see customer-otp.service.ts.
/// Only the SHA-256 hash of the code is stored, same reasoning as
/// PasswordResetToken: a database leak must not hand out working codes.
model CustomerOtp {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@map("customer_otps")
}

/// Mirrors the staff Session model's tracked-session pattern, scoped to
/// customers instead — a random token issued after OTP verification, stored
/// server-side so it can be revoked (sign out) without waiting for expiry.
/// Customers have no RBAC, so unlike staff this doesn't need Auth.js/JWTs —
/// the raw token is the cookie value, looked up directly on each request.
model CustomerSession {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  customerId   String   @map("customer_id")
  expires      DateTime

  createdAt DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_sessions")
}

/// area/city are free-text (not FK'd to City) because customer-entered
/// delivery addresses rarely align cleanly to administrative boundaries —
/// geographic analytics (Phase 8) normalizes/aggregates this text rather
/// than requiring clean input at capture time.
model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  label        String?
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  area         String?
  city         String?
  landmark     String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customerId])
  @@index([area])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// Cart — pre-checkout only. Cart items hold live references to Product/
// ModifierOption (prices are resolved at checkout time); once converted into
// an Order, everything is snapshotted and the cart no longer matters.
// ---------------------------------------------------------------------------

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Cart {
  id         String     @id @default(uuid())
  branchId   String     @map("branch_id")
  customerId String     @map("customer_id")
  type       OrderType  @default(PICKUP)
  status     CartStatus @default(ACTIVE)
  notes      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch   Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([customerId])
  @@index([branchId])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  quantity  Int     @default(1)
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart      Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers CartItemModifier[]

  @@index([cartId])
  @@map("cart_items")
}

model CartItemModifier {
  id               String @id @default(uuid())
  cartItemId       String @map("cart_item_id")
  modifierOptionId String @map("modifier_option_id")

  cartItem       CartItem       @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@unique([cartItemId, modifierOptionId])
  @@map("cart_item_modifiers")
}

// ---------------------------------------------------------------------------
// Orders — the state machine is enforced entirely in application code
// (order.state-machine.ts), never by CHECK constraints, since valid
// transitions depend on order type. This table only ever *records* the
// result. OrderItem/OrderItemModifier snapshot product name, price, and
// modifier price at the moment of order — a later price change must never
// alter historical orders.
// ---------------------------------------------------------------------------

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  ACCEPTED
  SENT_TO_KITCHEN
  PREPARING
  READY
  ASSIGNED_TO_RIDER
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  REJECTED
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number")
  /// Opaque, unguessable credential for the public/guest tracking page and
  /// its live-location feed — orderNumber ("FL-1015") is sequential and
  /// intentionally guessable, so it is fine for the human-readable order
  /// status page but must never gate live GPS access. See track/[token].
  trackingToken String    @unique @default(dbgenerated("replace(gen_random_uuid()::text, '-', '')")) @map("tracking_token")
  branchId    String      @map("branch_id")
  customerId  String      @map("customer_id")
  type        OrderType
  status      OrderStatus @default(DRAFT)

  subtotal      Decimal @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(10, 2)
  taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(10, 2)
  deliveryFee   Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
  currency      String  @default("GHS")

  notes             String?
  deliveryAddressId String?   @map("delivery_address_id")
  scheduledFor      DateTime? @map("scheduled_for")
  placedByUserId    String?   @map("placed_by_user_id")

  /// Which DeliveryZone (if any) priced this order's deliveryFee — null means the branch's defaultDeliveryFee applied instead. Kept for reference even if the zone is later edited/deactivated (SetNull, not a hard dependency).
  deliveryZoneId  String?   @map("delivery_zone_id")
  assignedRiderId String?   @map("assigned_rider_id")
  riderAssignedAt DateTime? @map("rider_assigned_at")

  /// Handoff PIN shown to the customer (on their tracking page) and required from the rider before DELIVERED is accepted — proves the parcel actually reached the right person. Generated at checkout for DELIVERY orders only; plaintext by design (a short-lived handoff PIN, not an auth secret) same posture as the payment dev-stubs elsewhere in this codebase.
  deliveryCode           String?   @map("delivery_code")
  deliveryCodeVerifiedAt DateTime? @map("delivery_code_verified_at")

  /// Which Promotion (if any) discounted this order — discountTotal is the
  /// resolved GHS amount, computed once at checkout and never recomputed.
  promotionId    String? @map("promotion_id")
  /// Loyalty points spent on this order (0 = none) — the GHS value they were
  /// worth is folded into discountTotal alongside any promotion discount.
  pointsRedeemed Int     @default(0) @map("points_redeemed")

  /// Guards checkout retries from creating duplicate orders — see checkout.service.ts.
  idempotencyKey String @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deliveryAddress CustomerAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  placedByUser    User?            @relation("OrderPlacedBy", fields: [placedByUserId], references: [id], onDelete: SetNull)
  deliveryZone    DeliveryZone?    @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  assignedRider   User?            @relation("OrderAssignedRider", fields: [assignedRiderId], references: [id], onDelete: SetNull)
  promotion       Promotion?       @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  supportTickets      SupportTicket[]
  review              Review?
  notifications       Notification[]
  deliveryLocation    DeliveryLocation?

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([assignedRiderId])
  @@index([promotionId])
  @@map("orders")
}

enum OrderItemKitchenStatus {
  PENDING
  PREPARING
  READY
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  productId    String  @map("product_id")
  productName  String  @map("product_name")
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity     Int
  lineSubtotal Decimal @map("line_subtotal") @db.Decimal(10, 2)
  notes        String?

  /// Snapshotted from Product.stationSlug at order time — kitchen routing
  /// stays stable even if the product's station assignment changes later.
  stationSlug   String?                @map("station_slug")
  kitchenStatus OrderItemKitchenStatus @default(PENDING) @map("kitchen_status")
  startedAt     DateTime?              @map("started_at")
  readyAt       DateTime?              @map("ready_at")

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([kitchenStatus])
  @@map("order_items")
}

model OrderItemModifier {
  id               String  @id @default(uuid())
  orderItemId      String  @map("order_item_id")
  modifierOptionId String? @map("modifier_option_id")
  optionName       String  @map("option_name")
  priceDelta       Decimal @map("price_delta") @db.Decimal(10, 2)

  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String       @map("order_id")
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId String?      @map("changed_by_user_id")
  reason          String?

  createdAt DateTime @default(now()) @map("created_at")

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Payments — never coupled to one gateway. `provider` identifies which
// PaymentProvider implementation handled it (see services/payments/providers);
// cash and mobile-money-dev ship now, real gateways slot in later behind the
// same interface. Payment success is always verified server-side, never
// trusted from client input — see payment.service.ts.
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @map("order_id")
  method            PaymentMethod
  provider          String
  providerReference String?       @unique @map("provider_reference")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("GHS")
  status            PaymentStatus @default(PENDING)
  initiatedByUserId String?       @map("initiated_by_user_id")
  metadata          Json?

  /// Guards duplicate payment-intent creation on retried requests.
  idempotencyKey String @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  initiatedByUser User?    @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  refunds         Refund[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id                String        @id @default(uuid())
  paymentId         String        @map("payment_id")
  amount            Decimal       @db.Decimal(10, 2)
  reason            String?
  status            PaymentStatus @default(PENDING)
  initiatedByUserId String?       @map("initiated_by_user_id")
  providerReference String?       @map("provider_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  initiatedByUser User?   @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("refunds")
}

/// Raw webhook log, deduped by (provider, externalId) so a retried delivery
/// from the provider can never be processed twice.
model PaymentWebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  externalId  String?   @map("external_id")
  eventType   String    @map("event_type")
  payload     Json
  processedAt DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, externalId])
  @@map("payment_webhook_events")
}

// ---------------------------------------------------------------------------
// Kitchen stations — per-branch (each branch has its own physical stations),
// matched to products via the logical Product.stationSlug tag rather than a
// direct FK, since Product is global and stations are not.
// ---------------------------------------------------------------------------

model KitchenStation {
  id        String  @id @default(uuid())
  branchId  String  @map("branch_id")
  name      String
  slug      String
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, slug])
  @@map("kitchen_stations")
}

// ---------------------------------------------------------------------------
// Inventory — Ingredients are global (like Product); stock is tracked per
// branch via BranchIngredientStock (like ProductBranchOverride). RecipeItem
// links a Product to the ingredients + quantities it consumes, so a kitchen
// sale can deduct real stock (see recipe.service.ts / stock.service.ts).
// StockMovement is an append-only ledger mirroring AuditLog — the only write
// path to BranchIngredientStock.quantityOnHand goes through it, so stock can
// always be reconstructed/audited from history.
// ---------------------------------------------------------------------------

model Ingredient {
  id           String  @id @default(uuid())
  name         String
  sku          String  @unique
  /// Free-text unit ("kg", "g", "l", "ml", "pcs") rather than an enum —
  /// kitchen units vary too much across ingredients to enumerate up front.
  unit         String
  reorderLevel Decimal @default(0) @map("reorder_level") @db.Decimal(10, 3)
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branchStocks       BranchIngredientStock[]
  recipeItems        RecipeItem[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([isActive])
  @@map("ingredients")
}

/// reorderLevel = null means "use the ingredient's global reorderLevel" — only
/// set a value here when this branch genuinely needs a different threshold
/// (mirrors the ProductBranchOverride price=null convention).
model BranchIngredientStock {
  id             String   @id @default(uuid())
  branchId       String   @map("branch_id")
  ingredientId   String   @map("ingredient_id")
  quantityOnHand Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(12, 3)
  reorderLevel   Decimal? @map("reorder_level") @db.Decimal(10, 3)

  updatedAt DateTime @updatedAt @map("updated_at")

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([branchId, ingredientId])
  @@index([branchId])
  @@map("branch_ingredient_stocks")
}

enum StockMovementType {
  RECEIPT
  SALE_DEDUCTION
  ADJUSTMENT
  WASTE
}

model StockMovement {
  id            String            @id @default(uuid())
  branchId      String            @map("branch_id")
  ingredientId  String            @map("ingredient_id")
  type          StockMovementType
  quantityDelta Decimal           @map("quantity_delta") @db.Decimal(12, 3)
  /// Snapshot of quantityOnHand immediately after this movement — lets any
  /// point in history be reconstructed without replaying the whole ledger.
  quantityAfter Decimal           @map("quantity_after") @db.Decimal(12, 3)
  reason        String?
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  actorUserId   String?           @map("actor_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  actorUser  User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([branchId, ingredientId])
  @@index([createdAt])
  @@map("stock_movements")
}

/// quantityPerUnit is expressed in the ingredient's own unit (Ingredient.unit)
/// — recipes do not perform unit conversion, so an ingredient's stock unit and
/// its recipe usage unit must be the same measure.
model RecipeItem {
  id              String  @id @default(uuid())
  productId       String  @map("product_id")
  ingredientId    String  @map("ingredient_id")
  quantityPerUnit Decimal @map("quantity_per_unit") @db.Decimal(10, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([productId, ingredientId])
  @@map("recipe_items")
}

// ---------------------------------------------------------------------------
// Procurement — suppliers and purchase orders. A PurchaseOrder only affects
// stock once its items are received (see purchase-order.service.ts); DRAFT/
// SUBMITTED orders are a paper trail, not a stock movement.
// ---------------------------------------------------------------------------

model Supplier {
  id       String  @id @default(uuid())
  name     String
  phone    String?
  email    String?
  address  String?
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  orderNumber     String              @unique @map("order_number")
  branchId        String              @map("branch_id")
  supplierId      String              @map("supplier_id")
  status          PurchaseOrderStatus @default(DRAFT)
  notes           String?
  createdByUserId String?             @map("created_by_user_id")
  submittedAt     DateTime?           @map("submitted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdByUser User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         PurchaseOrderItem[]

  @@index([branchId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  purchaseOrderId  String  @map("purchase_order_id")
  ingredientId     String  @map("ingredient_id")
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(12, 3)
  unitCost         Decimal @map("unit_cost") @db.Decimal(10, 2)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(12, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Delivery — zones price a DELIVERY order's fee by matching the customer's
// free-text address area (see CustomerAddress.area) against a per-branch zone
// list, rather than geofencing exact coordinates — Ghanaian delivery
// addresses are area-based, not precise geocoded points (same reasoning as
// CustomerAddress's own area/city fields). A rider is a User holding the
// RIDER role (see roles.ts); RiderProfile only holds the rider-specific
// fields most users don't need (vehicle, live status/location).
// ---------------------------------------------------------------------------

/// fee = what this order's deliveryFee is set to when areaMatch matches the
/// delivery address's area (case-insensitive). No match falls back to
/// Branch.defaultDeliveryFee — see checkout.service.ts.
model DeliveryZone {
  id               String  @id @default(uuid())
  branchId         String  @map("branch_id")
  name             String
  areaMatch        String  @map("area_match")
  fee              Decimal @db.Decimal(10, 2)
  estimatedMinutes Int?    @map("estimated_minutes")
  isActive         Boolean @default(true) @map("is_active")
  sortOrder        Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([branchId, areaMatch])
  @@index([branchId])
  @@map("delivery_zones")
}

enum RiderVehicleType {
  MOTORBIKE
  BICYCLE
  CAR
  ON_FOOT
}

enum RiderStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
}

/// Live status/position only — no historical breadcrumb trail (YAGNI until
/// route analytics are actually needed); currentLatitude/Longitude hold only
/// the rider's most recent ping.
model RiderProfile {
  id          String           @id @default(uuid())
  userId      String           @unique @map("user_id")
  branchId    String           @map("branch_id")
  vehicleType RiderVehicleType @default(MOTORBIKE) @map("vehicle_type")
  plateNumber String?          @map("plate_number")
  status      RiderStatus      @default(OFFLINE)

  currentLatitude  Decimal?  @map("current_latitude") @db.Decimal(10, 7)
  currentLongitude Decimal?  @map("current_longitude") @db.Decimal(10, 7)
  lastLocationAt   DateTime? @map("last_location_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([status])
  @@map("rider_profiles")
}

/// The rider's *current* position for one specific active delivery — one row
/// per order (orderId is unique), upserted on every accepted GPS ping, never
/// a growing history table. Deliberately separate from
/// RiderProfile.currentLatitude/Longitude (that field is the rider's global
/// "where are they right now" used by the branch delivery board regardless
/// of which order they're on; this table is delivery-scoped so the fields
/// specific to live navigation — heading, speed, accuracy, the GPS device's
/// own timestamp — have a home without overloading the profile). Row is
/// deleted once the delivery reaches a terminal state (see
/// delivery-location.service.ts) so a completed order can never keep
/// leaking a live position.
model DeliveryLocation {
  id        String  @id @default(uuid())
  orderId   String  @unique @map("order_id")
  riderId   String  @map("rider_id")
  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  /// Compass heading in degrees (0-360), when the device reports one.
  heading Decimal? @db.Decimal(5, 1)
  /// Meters/second, when the device reports one.
  speed Decimal? @db.Decimal(6, 2)
  /// GPS accuracy radius in meters, as reported by the device — used to reject/flag low-quality fixes.
  accuracy Decimal @db.Decimal(7, 1)
  /// The GPS fix's own timestamp (from the device), distinct from updatedAt (server receipt time) — staleness is judged from this.
  recordedAt DateTime @map("recorded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider User  @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@map("delivery_locations")
}

// ---------------------------------------------------------------------------
// Promotions — code-based only (no automatic "best discount" selection —
// out of scope until there's a real need for stacking/priority rules).
// Usage limits are enforced by counting real Orders against this promotion
// rather than a separate redemption ledger, so a cancelled/rejected/failed
// order naturally stops counting against the limit — see promotion.service.ts.
// ---------------------------------------------------------------------------

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Promotion {
  id            String                @id @default(uuid())
  code          String                @unique
  name          String
  description   String?
  discountType  PromotionDiscountType @map("discount_type")
  discountValue Decimal               @map("discount_value") @db.Decimal(10, 2)

  /// Order subtotal must be at least this much for the code to apply.
  minSubtotal       Decimal? @map("min_subtotal") @db.Decimal(10, 2)
  /// Caps the discount a PERCENTAGE promotion can give (e.g. "20% off, up to GHS 30").
  maxDiscountAmount Decimal? @map("max_discount_amount") @db.Decimal(10, 2)

  /// null = valid at every branch, matching ProductBranchOverride's convention.
  branchId String? @map("branch_id")

  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")

  usageLimit            Int? @map("usage_limit")
  usageLimitPerCustomer Int? @default(1) @map("usage_limit_per_customer")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders    Order[]
  campaigns Campaign[]

  @@index([isActive])
  @@index([branchId])
  @@map("promotions")
}

// ---------------------------------------------------------------------------
// Loyalty — LoyaltyAccount.pointsBalance is a cache kept in lockstep with
// LoyaltyTransaction (the append-only ledger) inside one transaction, the
// same recordStockMovement pattern as BranchIngredientStock/StockMovement in
// Phase 5. Config is a single configurable row rather than hard-coded
// earn/redeem rates — see the CRITICAL rule against hard-coded business
// constants (same reasoning as Branch.taxRate / defaultDeliveryFee).
// ---------------------------------------------------------------------------

model LoyaltyProgramConfig {
  /// Always "default" — singleton row, upserted rather than auto-generated.
  id String @id

  /// Points earned = floor(amountPaid * pointsPerCurrency).
  pointsPerCurrency Decimal @default(0.1) @map("points_per_currency") @db.Decimal(6, 4)
  /// GHS value of a single point when redeemed.
  redemptionValue   Decimal @default(0.5) @map("redemption_value") @db.Decimal(6, 4)
  minPointsToRedeem Int     @default(10) @map("min_points_to_redeem")
  isActive          Boolean @default(true) @map("is_active")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("loyalty_program_config")
}

model LoyaltyAccount {
  id                   String @id @default(uuid())
  customerId           String @unique @map("customer_id")
  pointsBalance        Int    @default(0) @map("points_balance")
  lifetimePointsEarned Int    @default(0) @map("lifetime_points_earned")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("loyalty_accounts")
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  ADJUSTED
}

/// points is signed: positive for EARNED and upward ADJUSTED, negative for
/// REDEEMED and downward ADJUSTED. balanceAfter snapshots the running total
/// so history can be audited without replaying the whole ledger.
model LoyaltyTransaction {
  id           String                 @id @default(uuid())
  customerId   String                 @map("customer_id")
  orderId      String?                @map("order_id")
  type         LoyaltyTransactionType
  points       Int
  balanceAfter Int                    @map("balance_after")
  reason       String?
  actorUserId  String?                @map("actor_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actorUser User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([orderId])
  @@map("loyalty_transactions")
}

// ---------------------------------------------------------------------------
// Marketing campaigns — a named initiative pairing a target audience with an
// incentive (a Promotion code). There's no messaging/send infrastructure
// yet (Phase 9), so a campaign doesn't "send" anything itself; audience size
// is computed live from real Customer/Order data, not a fabricated number.
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum CampaignAudience {
  ALL_CUSTOMERS
  NEW_CUSTOMERS
  RETURNING_CUSTOMERS
}

model Campaign {
  id          String           @id @default(uuid())
  name        String
  description String?
  status      CampaignStatus   @default(DRAFT)
  audience    CampaignAudience @default(ALL_CUSTOMERS)
  promotionId String?          @map("promotion_id")
  startsAt    DateTime?        @map("starts_at")
  endsAt      DateTime?        @map("ends_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// Support — order-scoped tickets raised from the public tracking page (see
// getPublicOrderTracking's own PII rule: no login exists for customers, so a
// ticket is created/replied to using only the order number as the capability,
// exactly like tracking itself). Staff work tickets from /admin/support.
// ---------------------------------------------------------------------------

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id               String              @id @default(uuid())
  customerId       String              @map("customer_id")
  orderId          String?             @map("order_id")
  branchId         String?             @map("branch_id")
  subject          String
  status           SupportTicketStatus @default(OPEN)
  assignedToUserId String?             @map("assigned_to_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  branch     Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedTo User?            @relation("SupportTicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([customerId])
  @@index([orderId])
  @@index([branchId])
  @@index([status])
  @@map("support_tickets")
}

enum SupportMessageAuthorType {
  CUSTOMER
  STAFF
}

model SupportMessage {
  id           String                   @id @default(uuid())
  ticketId     String                   @map("ticket_id")
  authorType   SupportMessageAuthorType @map("author_type")
  /// Set only when authorType = STAFF. The public thread never shows which
  /// staff member wrote a reply (see the no-PII rule above) — this is for
  /// internal accountability only, resolved to a display name in admin UI.
  authorUserId String?                  @map("author_user_id")
  body         String

  createdAt DateTime @default(now()) @map("created_at")

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@map("support_messages")
}

// ---------------------------------------------------------------------------
// Reviews — one per order, submittable from the public tracking page once an
// order reaches a terminal successful state. `status` lets staff hide abusive
// content without deleting it (same never-hard-delete posture as orders).
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model Review {
  id                String       @id @default(uuid())
  orderId           String       @unique @map("order_id")
  customerId        String       @map("customer_id")
  branchId          String       @map("branch_id")
  rating            Int
  comment           String?
  status            ReviewStatus @default(PUBLISHED)
  moderatedByUserId String?      @map("moderated_by_user_id")
  moderatedAt       DateTime?    @map("moderated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  moderatedBy User?    @relation("ReviewModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([status])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Notifications — a dev-stub send log, same posture as the Mobile Money
// payment provider (see payment.service.ts): no real SMS/email gateway is
// wired up, so recording a Notification row here IS the "send". A real
// provider slots in later behind the same notifyOrderStatus() call site.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  SENT
  FAILED
}

model Notification {
  id         String              @id @default(uuid())
  customerId String              @map("customer_id")
  orderId    String?             @map("order_id")
  channel    NotificationChannel
  status     NotificationStatus  @default(SENT)
  subject    String
  body       String

  createdAt DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([orderId])
  @@index([createdAt])
  @@map("notifications")
}
