// Flicks & Licks Restaurant OS — Phase 1: Foundation
// Identity, RBAC, multi-branch structure, audit logging.
// Later phases extend this file with orders, inventory, delivery, marketing, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Geography / Branch structure
// ---------------------------------------------------------------------------

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  isoCode   String   @unique
  currency  String   @default("GHS")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  regions Region[]

  @@map("countries")
}

model Region {
  id        String   @id @default(uuid())
  name      String
  countryId String   @map("country_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities  City[]

  @@unique([countryId, name])
  @@map("regions")
}

model City {
  id        String   @id @default(uuid())
  name      String
  regionId  String   @map("region_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  region   Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  branches Branch[]

  @@unique([regionId, name])
  @@map("cities")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
  TEMPORARILY_CLOSED
}

model Branch {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  cityId    String       @map("city_id")
  address   String
  latitude  Decimal?     @db.Decimal(10, 7)
  longitude Decimal?     @db.Decimal(10, 7)
  phone     String?
  email     String?
  status    BranchStatus @default(ACTIVE)
  timezone  String       @default("Africa/Accra")
  currency  String       @default("GHS")

  /// Configurable, not hard-coded — see CRITICAL rule against hard-coded tax rates. Defaults to 0 until finance configures it.
  taxRate Decimal @default(0) @map("tax_rate") @db.Decimal(5, 4)

  // JSON schedule: { mon: {open, close}, tue: {...}, ... }. Configurable per branch, not hard-coded.
  openingHours Json? @map("opening_hours")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  city             City                    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  userRoles        UserRole[]
  auditLogs        AuditLog[]
  productOverrides ProductBranchOverride[]
  carts            Cart[]
  orders           Order[]

  @@index([cityId])
  @@index([status])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  phone         String?   @unique
  phoneVerified DateTime? @map("phone_verified")
  passwordHash  String?   @map("password_hash")

  // Auth.js convenience fields (kept alongside the structured name/avatar fields below).
  name  String?
  image String?

  firstName String @map("first_name")
  lastName  String @map("last_name")

  status UserStatus @default(ACTIVE)

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  lastLoginIp         String?   @map("last_login_ip")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  accounts  Account[]
  sessions  Session[]
  userRoles UserRole[]
  auditLogs AuditLog[] @relation("AuditActor")

  placedOrders       Order[]              @relation("OrderPlacedBy")
  orderStatusChanges OrderStatusHistory[]
  paymentsInitiated  Payment[]
  refundsInitiated   Refund[]

  @@index([status])
  @@index([email])
  @@index([phone])
  @@map("users")
}

// Reserved for future OAuth / SSO providers. Credentials auth does not use this table today.
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  // Device/session tracking (security requirement: visibility into active sessions).
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// RBAC — roles and permissions are data, not hard-coded enums, so new roles
// or permissions can be introduced without a migration touching application code.
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// A user can hold multiple roles. branchId = null means the role applies
// globally across all branches (e.g. SUPER_ADMIN); a set branchId scopes
// that role assignment to a single branch (e.g. ADMIN for East Legon only).
model UserRole {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  roleId   String  @map("role_id")
  branchId String? @map("branch_id")

  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Audit — append-only from the application's perspective. No update/delete
// helpers are exposed anywhere in the service layer.
// ---------------------------------------------------------------------------

model AuditLog {
  id           String  @id @default(uuid())
  actorUserId  String? @map("actor_user_id")
  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id")
  branchId     String? @map("branch_id")

  before   Json?
  after    Json?
  metadata Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([resourceType, resourceId])
  @@index([branchId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog — products/categories/modifiers are global by default. A branch can
// override price and/or availability per product without duplicating it (see
// ProductBranchOverride) — this is what lets one branch sell an item another
// doesn't, or price it differently, without forking the catalog.
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String? @map("image_url")
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("categories")
}

model Product {
  id          String  @id @default(uuid())
  categoryId  String  @map("category_id")
  name        String
  slug        String  @unique
  description String?
  basePrice   Decimal @map("base_price") @db.Decimal(10, 2)
  imageUrl    String? @map("image_url")
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  branchOverrides ProductBranchOverride[]
  modifierGroups  ProductModifierGroup[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

/// price = null means "use the product's basePrice at this branch" — only set
/// a value here when this branch genuinely charges a different price.
model ProductBranchOverride {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  branchId    String   @map("branch_id")
  price       Decimal? @db.Decimal(10, 2)
  isAvailable Boolean  @default(true) @map("is_available")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@map("product_branch_overrides")
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

model ModifierGroup {
  id            String                @id @default(uuid())
  name          String
  selectionType ModifierSelectionType @default(SINGLE) @map("selection_type")
  isRequired    Boolean               @default(false) @map("is_required")
  minSelect     Int                   @default(0) @map("min_select")
  maxSelect     Int?                  @map("max_select")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  options  ModifierOption[]
  products ProductModifierGroup[]

  @@map("modifier_groups")
}

model ModifierOption {
  id              String  @id @default(uuid())
  modifierGroupId String  @map("modifier_group_id")
  name            String
  priceDelta      Decimal @default(0) @map("price_delta") @db.Decimal(10, 2)
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int     @default(0) @map("sort_order")

  modifierGroup  ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  cartItemLinks  CartItemModifier[]
  orderItemLinks OrderItemModifier[]

  @@index([modifierGroupId])
  @@map("modifier_options")
}

model ProductModifierGroup {
  productId       String @map("product_id")
  modifierGroupId String @map("modifier_group_id")
  sortOrder       Int    @default(0) @map("sort_order")

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

// ---------------------------------------------------------------------------
// Customers — deliberately separate from User: customers are never granted
// RBAC roles, and passwordHash is optional so guest customers created by
// staff (POS walk-ins) don't need an account at all.
// ---------------------------------------------------------------------------

enum CustomerStatus {
  ACTIVE
  GUEST
  SUSPENDED
}

model Customer {
  id            String         @id @default(uuid())
  email         String?        @unique
  emailVerified DateTime?      @map("email_verified")
  phone         String?        @unique
  phoneVerified DateTime?      @map("phone_verified")
  passwordHash  String?        @map("password_hash")
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  status        CustomerStatus @default(GUEST)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  addresses CustomerAddress[]
  carts     Cart[]
  orders    Order[]

  @@index([status])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

/// area/city are free-text (not FK'd to City) because customer-entered
/// delivery addresses rarely align cleanly to administrative boundaries —
/// geographic analytics (Phase 8) normalizes/aggregates this text rather
/// than requiring clean input at capture time.
model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  label        String?
  addressLine1 String   @map("address_line_1")
  addressLine2 String?  @map("address_line_2")
  area         String?
  city         String?
  landmark     String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([customerId])
  @@index([area])
  @@map("customer_addresses")
}

// ---------------------------------------------------------------------------
// Cart — pre-checkout only. Cart items hold live references to Product/
// ModifierOption (prices are resolved at checkout time); once converted into
// an Order, everything is snapshotted and the cart no longer matters.
// ---------------------------------------------------------------------------

enum OrderType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model Cart {
  id         String     @id @default(uuid())
  branchId   String     @map("branch_id")
  customerId String     @map("customer_id")
  type       OrderType  @default(PICKUP)
  status     CartStatus @default(ACTIVE)
  notes      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch   Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([customerId])
  @@index([branchId])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  quantity  Int     @default(1)
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart      Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers CartItemModifier[]

  @@index([cartId])
  @@map("cart_items")
}

model CartItemModifier {
  id               String @id @default(uuid())
  cartItemId       String @map("cart_item_id")
  modifierOptionId String @map("modifier_option_id")

  cartItem       CartItem       @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@unique([cartItemId, modifierOptionId])
  @@map("cart_item_modifiers")
}

// ---------------------------------------------------------------------------
// Orders — the state machine is enforced entirely in application code
// (order.state-machine.ts), never by CHECK constraints, since valid
// transitions depend on order type. This table only ever *records* the
// result. OrderItem/OrderItemModifier snapshot product name, price, and
// modifier price at the moment of order — a later price change must never
// alter historical orders.
// ---------------------------------------------------------------------------

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  ACCEPTED
  SENT_TO_KITCHEN
  PREPARING
  READY
  ASSIGNED_TO_RIDER
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  REJECTED
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @map("order_number")
  branchId    String      @map("branch_id")
  customerId  String      @map("customer_id")
  type        OrderType
  status      OrderStatus @default(DRAFT)

  subtotal      Decimal @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(10, 2)
  taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(10, 2)
  deliveryFee   Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
  currency      String  @default("GHS")

  notes             String?
  deliveryAddressId String?   @map("delivery_address_id")
  scheduledFor      DateTime? @map("scheduled_for")
  placedByUserId    String?   @map("placed_by_user_id")

  /// Guards checkout retries from creating duplicate orders — see checkout.service.ts.
  idempotencyKey String @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deliveryAddress CustomerAddress? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  placedByUser    User?            @relation("OrderPlacedBy", fields: [placedByUserId], references: [id], onDelete: SetNull)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  productId    String  @map("product_id")
  productName  String  @map("product_name")
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity     Int
  lineSubtotal Decimal @map("line_subtotal") @db.Decimal(10, 2)
  notes        String?

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id               String  @id @default(uuid())
  orderItemId      String  @map("order_item_id")
  modifierOptionId String? @map("modifier_option_id")
  optionName       String  @map("option_name")
  priceDelta       Decimal @map("price_delta") @db.Decimal(10, 2)

  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String       @map("order_id")
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId String?      @map("changed_by_user_id")
  reason          String?

  createdAt DateTime @default(now()) @map("created_at")

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Payments — never coupled to one gateway. `provider` identifies which
// PaymentProvider implementation handled it (see services/payments/providers);
// cash and mobile-money-dev ship now, real gateways slot in later behind the
// same interface. Payment success is always verified server-side, never
// trusted from client input — see payment.service.ts.
// ---------------------------------------------------------------------------

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @map("order_id")
  method            PaymentMethod
  provider          String
  providerReference String?       @unique @map("provider_reference")
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("GHS")
  status            PaymentStatus @default(PENDING)
  initiatedByUserId String?       @map("initiated_by_user_id")
  metadata          Json?

  /// Guards duplicate payment-intent creation on retried requests.
  idempotencyKey String @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  initiatedByUser User?    @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)
  refunds         Refund[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Refund {
  id                String        @id @default(uuid())
  paymentId         String        @map("payment_id")
  amount            Decimal       @db.Decimal(10, 2)
  reason            String?
  status            PaymentStatus @default(PENDING)
  initiatedByUserId String?       @map("initiated_by_user_id")
  providerReference String?       @map("provider_reference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  initiatedByUser User?   @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("refunds")
}

/// Raw webhook log, deduped by (provider, externalId) so a retried delivery
/// from the provider can never be processed twice.
model PaymentWebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  externalId  String?   @map("external_id")
  eventType   String    @map("event_type")
  payload     Json
  processedAt DateTime? @map("processed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([provider, externalId])
  @@map("payment_webhook_events")
}
